# Makefile for python interface for package error_demo.
# File is generated by gopy version v0.5.0. Do not edit.
# gopy.exe build -output=out -vm=python3 .

GOCMD=go
GOBUILD=$(GOCMD) build -mod=mod
GOIMPORTS=goimports
PYTHON=C:\Users\tadij\PycharmProjects\GoPy test\.venv\Scripts\python3.exe
LIBEXT=.pyd

# get the CC and flags used to build python:
GCC = $(shell $(GOCMD) env CC)
CFLAGS = "-IC:/Users/tadij/AppData/Local/Programs/Python/Python314/Include"
LDFLAGS = "-LC:/Users/tadij/AppData/Local/Programs/Python/Python314/libs" "-lpython314.dll"  

all: gen build

gen:
	gopy.exe build -no-make -vm=python3 .

build:
	# build target builds the generated files -- this is what gopy build does..
	# this will otherwise be built during go build and may be out of date
	- rm error_demo.c
	# goimports is needed to ensure that the imports list is valid
	$(GOIMPORTS) -w error_demo.go
	# generate error_demo_go$(LIBEXT) from error_demo.go -- the cgo wrappers to go functions
	$(GOBUILD) -buildmode=c-shared -o error_demo_go$(LIBEXT) error_demo.go
	# use pybindgen to build the error_demo.c file which are the CPython wrappers to cgo wrappers..
	# note: pip install pybindgen to get pybindgen if this fails
	$(PYTHON) build.py
	# build the _error_demo$(LIBEXT) library that contains the cgo and CPython wrappers
	# generated error_demo.py python wrapper imports this c-code package
	# windows-only sed hack here to fix pybindgen declaration of PyInit
  sed -i "s/ PyInit_/ __declspec(dllexport) PyInit_/g" error_demo.c
	$(GCC) error_demo.c  error_demo_go$(LIBEXT) -o _error_demo$(LIBEXT) $(CFLAGS) $(LDFLAGS) -fPIC --shared -w
	


