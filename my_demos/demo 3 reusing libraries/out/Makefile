# Makefile for python interface for package libraries_in_go.
# File is generated by gopy version v0.5.0. Do not edit.
# gopy.exe build -output=out -vm=python3 .

GOCMD=go
GOBUILD=$(GOCMD) build -mod=mod
GOIMPORTS=goimports
PYTHON=C:\Users\tadij\PycharmProjects\GoPy test\.venv\Scripts\python3.exe
LIBEXT=.pyd

# get the CC and flags used to build python:
GCC = $(shell $(GOCMD) env CC)
CFLAGS = "-IC:/Users/tadij/AppData/Local/Programs/Python/Python314/Include"
LDFLAGS = "-LC:/Users/tadij/AppData/Local/Programs/Python/Python314/libs" "-lpython314.dll"  

all: gen build

gen:
	gopy.exe build -no-make -vm=python3 .

build:
	# build target builds the generated files -- this is what gopy build does..
	# this will otherwise be built during go build and may be out of date
	- rm libraries_in_go.c
	# goimports is needed to ensure that the imports list is valid
	$(GOIMPORTS) -w libraries_in_go.go
	# generate libraries_in_go_go$(LIBEXT) from libraries_in_go.go -- the cgo wrappers to go functions
	$(GOBUILD) -buildmode=c-shared -o libraries_in_go_go$(LIBEXT) libraries_in_go.go
	# use pybindgen to build the libraries_in_go.c file which are the CPython wrappers to cgo wrappers..
	# note: pip install pybindgen to get pybindgen if this fails
	$(PYTHON) build.py
	# build the _libraries_in_go$(LIBEXT) library that contains the cgo and CPython wrappers
	# generated libraries_in_go.py python wrapper imports this c-code package
	# windows-only sed hack here to fix pybindgen declaration of PyInit
  sed -i "s/ PyInit_/ __declspec(dllexport) PyInit_/g" libraries_in_go.c
	$(GCC) libraries_in_go.c  libraries_in_go_go$(LIBEXT) -o _libraries_in_go$(LIBEXT) $(CFLAGS) $(LDFLAGS) -fPIC --shared -w
	


