# Makefile for python interface for package testlib.
# File is generated by gopy version v0.5.0. Do not edit.
# gopy.exe build -output=out -vm=python ./

GOCMD=go
GOBUILD=$(GOCMD) build -mod=mod
GOIMPORTS=goimports
PYTHON=C:\Users\tadij\AppData\Local\Programs\Python\Python314\python.exe
LIBEXT=.pyd

# get the CC and flags used to build python:
GCC = $(shell $(GOCMD) env CC)
CFLAGS = "-IC:/Users/tadij/AppData/Local/Programs/Python/Python314/Include"
LDFLAGS = "-LC:/Users/tadij/AppData/Local/Programs/Python/Python314/libs" "-lpython314.dll"  

all: gen build

gen:
	gopy.exe build -no-make -vm=python ./

build:
	# build target builds the generated files -- this is what gopy build does..
	# this will otherwise be built during go build and may be out of date
	- rm testlib.c
	# goimports is needed to ensure that the imports list is valid
	$(GOIMPORTS) -w testlib.go
	# generate testlib_go$(LIBEXT) from testlib.go -- the cgo wrappers to go functions
	$(GOBUILD) -buildmode=c-shared -o testlib_go$(LIBEXT) testlib.go
	# use pybindgen to build the testlib.c file which are the CPython wrappers to cgo wrappers..
	# note: pip install pybindgen to get pybindgen if this fails
	$(PYTHON) build.py
	# build the _testlib$(LIBEXT) library that contains the cgo and CPython wrappers
	# generated testlib.py python wrapper imports this c-code package
	# windows-only sed hack here to fix pybindgen declaration of PyInit
  sed -i "s/ PyInit_/ __declspec(dllexport) PyInit_/g" testlib.c
	$(GCC) testlib.c  testlib_go$(LIBEXT) -o _testlib$(LIBEXT) $(CFLAGS) $(LDFLAGS) -fPIC --shared -w
	


